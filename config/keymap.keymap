#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp TAB        &kp Q  &kp W             &kp E     &kp R             &kp T      &kp Y      &kp U      &kp I           &kp O           &kp P          &kp BSPC
&mt RCTRL ESC  &kp A  &kp S             &kp D     &kp F             &kp G      &kp H      &kp J      &kp K           &kp L           &kp SEMICOLON  &kp ENTER
&kp LSHFT      &kp Z  &kp X             &kp C     &kp V             &kp B      &kp SPACE  &kp SPACE  &kp N           &kp M           &kp COMMA      &kp DOT          &kp SLASH  &kp RSHFT
&none          &none  &kp LEFT_CONTROL  &kp LALT  &kp LEFT_COMMAND  &kp SPACE  &mo 3      &mo 2      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &mkp LCLK  &mo 4             &mkp RCLK  &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RG(LEFT_BRACKET)  &mkp MB1   &mkp MB3          &mkp MB2   &kp RG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &kp LC(UP_ARROW)  &trans     &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &trans     &trans            &trans     &trans                 &trans
            >;
        };

        Num,Sym {
            bindings = <
&kp GRAVE  &mt F1 N1  &mt F2 N2  &mt F3 N3  &mt F4 N4   &mt F5 N5  &mt F6 N6  &mt F7 N7      &mt F8 N8  &mt F9 N9             &mt F10 N0             &mt EQUAL MINUS
&kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans     &trans     &trans     &trans     &trans      &trans     &trans     &trans         &trans     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans     &trans     &trans     &trans     &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &trans
            >;
        };

        Media {
            bindings = <
&trans        &trans         &trans                &trans        &trans             &trans           &trans                &trans                &trans                    &trans                    &trans                    &trans
&out OUT_USB  &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))      &kp LS(LG(NUMBER_5))      &trans                    &trans
&out OUT_BLE  &bt BT_SEL 0   &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3       &trans           &trans                &trans                &kp LS(LC(LG(NUMBER_2)))  &kp LS(LC(LG(NUMBER_3)))  &kp LS(LC(LG(NUMBER_4)))  &kp LS(LC(LG(NUMBER_5)))  &trans  &trans
&trans        &bt BT_PRV     &bt BT_NXT            &bt BT_CLR    &bt BT_CLR_ALL     &trans           &trans                &trans                &trans                    &trans                    &trans                    &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
