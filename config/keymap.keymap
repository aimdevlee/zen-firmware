#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices. MOUSE (1) and SCROLL (4) are referenced by
// boards/shields/zen/zen_right.overlay, so they must stay at 1 and 4.
#define BASE   0
#define MOUSE  1
#define NUM    2
#define FUN    3
#define SCROLL 4

// macOS Hyper = Shift + Ctrl + Option + Cmd
#define HYPER LS(LC(LA(LGUI)))

/ {
    behaviors {
        // Tap: Esc / Hold: Ctrl.
        // "balanced": Ctrl only when another key is pressed and released
        // while this key is held, so a quick Esc never turns into Ctrl.
        esc_ctrl: esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp TAB                &kp Q    &kp W    &kp E      &kp R     &kp T     &kp Y      &kp U      &kp I         &kp O       &kp P          &kp BSPC
&esc_ctrl LCTRL ESC    &kp A    &kp S    &kp D      &kp F     &kp G     &kp H      &kp J      &kp K         &kp L       &kp SEMICOLON  &kp ENTER
&kp LSHFT              &kp Z    &kp X    &kp C      &kp V     &kp B     &none      &none      &kp N         &kp M       &kp COMMA      &kp DOT    &kp SLASH  &kp RSHFT
&mo FUN                &mo NUM  &kp HYPER &kp LCTRL &kp LALT  &kp LGUI  &kp SPACE  &kp SPACE  &kp LEFT      &kp UP      &kp DOWN       &kp RIGHT
            >;
        };

        // Turned on automatically while the trackball moves.
        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mo SCROLL  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LBKT)  &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp LG(RBKT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(UP)  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Right-hand numpad. Shift (base, transparent) gives the shifted symbols.
        Num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp SQT   &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp BSLH  &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp GRAVE  &kp N0  &trans  &trans  &trans
            >;
        };

        // Left: Bluetooth / media / brightness. Right: F-keys at the numpad spots.
        Fun {
            bindings = <
&trans  &bt BT_CLR      &out OUT_TOG    &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &trans  &kp F7  &kp F8  &kp F9  &kp F11  &trans
&trans  &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_BRI_DN    &kp C_BRI_UP    &trans  &kp F4  &kp F5  &kp F6  &kp F12  &trans
&trans  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &trans  &trans
&trans  &trans          &trans          &trans          &trans          &trans          &trans  &trans  &kp F10  &trans  &trans  &trans
            >;
        };

        // Trackball scrolls while this layer is on (held from Mouse).
        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
